---
// Página Servicios - Nuestros Servicios
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroServicios from '../components/HeroServicios.astro';
import Services from '../components/Services.astro';
import Footer from '../components/Footer.astro';

const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Inicio",
        "item": "https://www.s3aindustrial.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Servicios",
        "item": "https://www.s3aindustrial.com/servicios"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "provider": {
      "@type": "LocalBusiness",
      "@id": "https://www.s3aindustrial.com/#organization"
    },
    "areaServed": "Argentina",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Servicios de Mantenimiento Industrial",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Reparación de Sopladores Industriales",
            "description": "Diagnóstico y reparación de sopladores de raíz, turbo sopladores y equipos afines en las instalaciones del cliente."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Mantenimiento Preventivo Industrial",
            "description": "Programas de mantenimiento preventivo para maximizar la vida útil y disponibilidad de sopladores industriales."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Mantenimiento Correctivo Industrial",
            "description": "Intervención correctiva ante fallas para restablecer la operación de equipos críticos."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Diagnóstico Técnico en Sitio",
            "description": "Evaluación técnica especializada en planta sin traslado del equipo."
          }
        }
      ]
    }
  }
];
---

<Layout
  title="Servicios de Mantenimiento Industrial | S3A Industrial — Sopladores Industriales"
  description="Reparación de sopladores, mantenimiento preventivo y correctivo, diagnóstico técnico en sitio y más. S3A Industrial ofrece soluciones industriales rápidas, confiables y con garantía."
  canonicalURL="https://www.s3aindustrial.com/servicios"
  pageSchema={pageSchema}
>
  <!-- Header fijo -->
  <Header />
  
  <!-- Main content -->
  <main>
    <!-- Hero Section -->
    <HeroServicios />
    
    <!-- Services Section -->
    <Services />
    
    <!-- Footer -->
    <Footer />
  </main>
</Layout>