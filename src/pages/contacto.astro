---
// Página Contacto - Contáctenos
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroContacto from '../components/HeroContacto.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';

const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Inicio",
        "item": "https://www.s3aindustrial.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Contacto",
        "item": "https://www.s3aindustrial.com/contacto"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "@id": "https://www.s3aindustrial.com/contacto",
    "url": "https://www.s3aindustrial.com/contacto",
    "name": "Contacto - S3A Industrial",
    "description": "Contáctenos para solicitar servicio técnico de sopladores industriales. Atención por email, WhatsApp y formulario de contacto.",
    "publisher": {
      "@id": "https://www.s3aindustrial.com/#organization"
    },
    "inLanguage": "es-AR"
  }
];
---

<Layout
  title="Contacto | S3A Industrial — Solicitá tu Servicio Técnico de Sopladores"
  description="Contáctá a S3A Industrial para reparación y mantenimiento de sopladores industriales. Completá el formulario, escribínos por WhatsApp o llamános. Respuesta rápida y atención personalizada."
  canonicalURL="https://www.s3aindustrial.com/contacto"
  pageSchema={pageSchema}
>
  <!-- Header fijo -->
  <Header />
  
  <!-- Main content -->
  <main>
    <!-- Hero Section -->
    <HeroContacto />
    
    <!-- Contact Form Section -->
    <ContactForm />
    
    <!-- Footer -->
    <Footer />
  </main>
</Layout>