---
// Página Principal - S3A Industrial
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Industries from '../components/IndustriesNew.astro';
import Process from '../components/ProcessNew.astro';
import CTAFinal from '../components/CTAFinalNew.astro';
import Footer from '../components/Footer.astro';

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.s3aindustrial.com/",
  "url": "https://www.s3aindustrial.com/",
  "name": "S3A Industrial | Reparación y Mantenimiento de Sopladores Industriales en Argentina",
  "description": "S3A Industrial — especialistas en reparación y mantenimiento de sopladores industriales. Servicio técnico en planta, mantenimiento preventivo y correctivo en Argentina.",
  "publisher": {
    "@id": "https://www.s3aindustrial.com/#organization"
  },
  "inLanguage": "es-AR",
  "isPartOf": {
    "@id": "https://www.s3aindustrial.com/#website"
  }
};
---

<Layout
  title="S3A Industrial | Reparación y Mantenimiento de Sopladores Industriales en Argentina"
  description="S3A Industrial — especialistas en reparación y mantenimiento de sopladores industriales. Servicio técnico en planta, mantenimiento preventivo y correctivo. Respuesta rápida y diagnóstico eficiente. ¡Solicitá tu cotización!"
  canonicalURL="https://www.s3aindustrial.com/"
  pageSchema={pageSchema}
>
  <!-- Header fijo -->
  <Header />
  
  <!-- Main content -->
  <main>
    <!-- Hero Section -->
    <Hero />
    
    <!-- Industries Section -->
    <Industries />
    
    <!-- Process Section -->
    <Process />
    
    <!-- Final CTA Section -->
    <CTAFinal />
    
    <!-- Footer -->
    <Footer />
  </main>
</Layout>
