---
// Página Cobertura - Cobertura de Servicio
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroCobertura from '../components/HeroCobertura.astro';
import Coverage from '../components/Coverage.astro';
import Footer from '../components/Footer.astro';

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": "https://www.s3aindustrial.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Zona de Cobertura",
      "item": "https://www.s3aindustrial.com/cobertura"
    }
  ]
};
---

<Layout
  title="Zona de Cobertura | S3A Industrial — Servicio Técnico de Sopladores en Sitio"
  description="S3A Industrial llega a tu planta. Conocé nuestra zona de cobertura para reparación y mantenimiento de sopladores industriales. Nos desplazamos a tu instalación en toda la región, sin que pares la producción."
  canonicalURL="https://www.s3aindustrial.com/cobertura"
  pageSchema={pageSchema}
>
  <!-- Header fijo -->
  <Header />
  
  <!-- Main content -->
  <main>
    <!-- Hero Section -->
    <HeroCobertura />
    
    <!-- Coverage Section -->
    <Coverage />
    
    <!-- Footer -->
    <Footer />
  </main>
</Layout>