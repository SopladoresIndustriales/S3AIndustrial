---
import '../styles/global.css';
import '../styles/animations.css';

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = 'S3A Industrial | Reparación y Mantenimiento de Sopladores Industriales',
  description = 'S3A Industrial — especialistas en reparación, mantenimiento preventivo y correctivo de sopladores industriales. Servicio técnico profesional en planta, respuesta rápida y diagnóstico eficiente.',
  canonicalURL = Astro.url.href,
  ogImage = '/og-image.png',
  noindex = false,
} = Astro.props;

const siteName = 'S3A Industrial';
const siteURL = (Astro.site?.toString().replace(/\/$/, '')) ?? 'https://s3a-industrial.vercel.app';

// JSON-LD: LocalBusiness structured data
const jsonLD = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "S3A Industrial",
  "description": "Empresa especializada en reparación y mantenimiento de sopladores industriales. Servicio técnico en sitio con mantenimiento preventivo y correctivo.",
  "url": siteURL,
  "logo": `${siteURL}/logo/logo2.svg`,
  "image": `${siteURL}/logo/logo1.png`,
  "telephone": "+54 9 11 2459-9330",
  "email": "contacto@s3aindustrial.com",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "AR",
    "addressRegion": "Buenos Aires"
  },
  "areaServed": {
    "@type": "Country",
    "name": "Argentina"
  },
  "serviceType": [
    "Reparación de Sopladores Industriales",
    "Mantenimiento Preventivo Industrial",
    "Mantenimiento Correctivo Industrial",
    "Diagnóstico Técnico en Sitio"
  ],
  "sameAs": [],
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "opens": "08:00",
    "closes": "18:00"
  }
});
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- ── Título y descripción ── -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- ── SEO básico ── -->
    <meta name="author" content="S3A Industrial" />
    <meta name="keywords" content="sopladores industriales, reparación sopladores, mantenimiento sopladores industriales, servicio técnico industrial, mantenimiento preventivo industrial, mantenimiento correctivo, sopladores de raíz, reparación en sitio, Argentina" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalURL} />

    <!-- ── Open Graph (Facebook / LinkedIn / WhatsApp) ── -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={`${siteURL}${ogImage}`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="S3A Industrial — Reparación y Mantenimiento de Sopladores Industriales" />
    <meta property="og:locale" content="es_AR" />

    <!-- ── Twitter / X Card ── -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteURL}${ogImage}`} />
    <meta name="twitter:image:alt" content="S3A Industrial — Reparación y Mantenimiento de Sopladores Industriales" />

    <!-- ── Favicon (logo de la empresa en la pestaña) ── -->
    <link rel="icon" type="image/svg+xml" href="/logo/logo2.svg" />
    <link rel="alternate icon" type="image/png" href="/logo/logo1.png" />
    <link rel="apple-touch-icon" href="/logo/logo1.png" />
    <meta name="theme-color" content="#1a1a2e" />

    <!-- ── JSON-LD: datos estructurados LocalBusiness ── -->
    <script type="application/ld+json" set:html={jsonLD} />

    <!-- ── Google Fonts ── -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow+Condensed:wght@400;500;600;700;800;900&family=Barlow:wght@400;500;600;700;800&family=Roboto:wght@300;400;500;700;900&display=swap" rel="stylesheet" />
  </head>
  <body class="antialiased">
    <slot />

    <!-- ── Botón flotante WhatsApp ── -->
    <a
      href="https://wa.me/5491124599330"
      id="wa-fab"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contactar por WhatsApp"
    >
      <span class="wa-fab-ring"></span>
      <svg width="28" height="28" viewBox="0 0 24 24" fill="white">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>
    <style>
      #wa-fab {
        position: fixed;
        bottom: 28px;
        right: 24px;
        z-index: 9999;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, #25d366 0%, #128c7e 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 6px 24px rgba(37,211,102,.50), 0 2px 8px rgba(0,0,0,.20);
        text-decoration: none;
        transition: transform .3s cubic-bezier(.34,1.56,.64,1), box-shadow .3s ease;
      }
      #wa-fab:hover {
        transform: scale(1.12) translateY(-3px);
        box-shadow: 0 10px 32px rgba(37,211,102,.60), 0 4px 12px rgba(0,0,0,.25);
      }
      #wa-fab:active { transform: scale(0.96); }
      .wa-fab-ring {
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        border: 2px solid rgba(37,211,102,.45);
        animation: wa-ring-pulse 2.4s ease-in-out infinite;
        pointer-events: none;
      }
      @keyframes wa-ring-pulse {
        0%   { transform: scale(1);    opacity: .8; }
        70%  { transform: scale(1.22); opacity: 0; }
        100% { transform: scale(1);    opacity: 0; }
      }
    </style>
    <script>
      // Intersection Observer para animaciones en scroll
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
          }
        });
      }, observerOptions);

      // Observar todos los elementos con clase animate-on-scroll
      document.addEventListener('DOMContentLoaded', () => {
        const animatedElements = document.querySelectorAll('.animate-on-scroll');
        animatedElements.forEach(el => observer.observe(el));
      });
    </script>
  </body>
</html>
