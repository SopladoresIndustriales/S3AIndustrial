---
// Sección: Señales de que su soplador necesita mantenimiento
---

<section id="senales" class="signals-section">
  <!-- Background decoration -->
  <div class="signals-orb signals-orb-1" aria-hidden="true"></div>
  <div class="signals-orb signals-orb-2" aria-hidden="true"></div>

  <!-- Top gold rule -->
  <div class="signals-top-rule" aria-hidden="true"></div>

  <div class="signals-container">

    <!-- ── HEADER ── -->
    <header class="signals-header reveal">
      <div class="signals-eyebrow">
        <span class="signals-eyebrow-dot"></span>
        <span class="signals-eyebrow-text">Diagnóstico Temprano</span>
      </div>

      <h2 class="signals-title">
        Señales de que su soplador<br>
        <em>necesita mantenimiento</em>
      </h2>
      <div class="signals-scratch"></div>

      <p class="signals-subtitle">
        Identificar estos síntomas a tiempo puede evitar una parada de planta costosa.
        <strong>¿Su equipo presenta alguno de estos problemas?</strong>
      </p>
    </header>

    <!-- ── CARDS GRID ── -->
    <div class="signals-grid" role="list">

      <!-- 01 Ruido anormal -->
      <article class="signal-card reveal reveal-d1" role="listitem">
        <div class="signal-icon-wrap signal-icon--amber">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072M12 6v12m0 0a9 9 0 01-9-9m9 9a9 9 0 009-9M3 12a9 9 0 019-9"/>
          </svg>
        </div>
        <div class="signal-num">01</div>
        <h3 class="signal-title">Ruido anormal</h3>
        <p class="signal-desc">Golpeteos, chirridos o ruidos metálicos inusuales durante el funcionamiento del equipo.</p>
        <span class="signal-tag">Desgaste interno</span>
      </article>

      <!-- 02 Pérdida de caudal/presión -->
      <article class="signal-card reveal reveal-d2" role="listitem">
        <div class="signal-icon-wrap signal-icon--red">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"/>
          </svg>
        </div>
        <div class="signal-num">02</div>
        <h3 class="signal-title">Pérdida de caudal / presión</h3>
        <p class="signal-desc">Caída en el rendimiento: el equipo ya no entrega el caudal o la presión nominales de diseño.</p>
        <span class="signal-tag">Rendimiento reducido</span>
      </article>

      <!-- 03 Calentamiento excesivo -->
      <article class="signal-card reveal reveal-d3" role="listitem">
        <div class="signal-icon-wrap signal-icon--orange">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z"/>
          </svg>
        </div>
        <div class="signal-num">03</div>
        <h3 class="signal-title">Calentamiento excesivo</h3>
        <p class="signal-desc">Temperatura de operación por encima de los valores normales; carcasa o lubricante sobrecalentados.</p>
        <span class="signal-tag">Riesgo de parada</span>
      </article>

      <!-- 04 Fugas de aceite / sellos -->
      <article class="signal-card reveal reveal-d4" role="listitem">
        <div class="signal-icon-wrap signal-icon--blue">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 2C6 8 4 12 4 14a8 8 0 0016 0c0-2-2-6-8-12z"/>
          </svg>
        </div>
        <div class="signal-num">04</div>
        <h3 class="signal-title">Fugas en sellos / aceite</h3>
        <p class="signal-desc">Pérdidas de aceite o aire en juntas y sellos, manchas bajo el equipo o contaminación del proceso.</p>
        <span class="signal-tag">Sellos deteriorados</span>
      </article>

      <!-- 05 Vibración excesiva -->
      <article class="signal-card reveal reveal-d5" role="listitem">
        <div class="signal-icon-wrap signal-icon--amber">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
          </svg>
        </div>
        <div class="signal-num">05</div>
        <h3 class="signal-title">Vibración excesiva</h3>
        <p class="signal-desc">Vibraciones inusuales que se transmiten a la estructura, cañerías o accesorios del equipo.</p>
        <span class="signal-tag">Desbalance / desgaste</span>
      </article>

    </div><!-- /signals-grid -->

    <!-- ── BOTTOM CTA ── -->
    <div class="signals-cta reveal" style="transition-delay:.25s">
      <div class="signals-cta-icon" aria-hidden="true">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
      </div>
      <div class="signals-cta-text">
        <p class="signals-cta-title">¿Su soplador presenta alguno de estos síntomas?</p>
        <p class="signals-cta-sub">No espere a que falle. Cada hora de parada no planificada cuesta más que un mantenimiento preventivo.</p>
      </div>
      <div class="signals-cta-actions">
        <a href="https://wa.me/5491124599330" target="_blank" rel="noopener noreferrer" class="signals-btn signals-btn--wa">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.554 4.118 1.525 5.845L.057 23.986l6.306-1.452A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.013-1.374l-.36-.213-3.737.859.882-3.626-.234-.372A9.818 9.818 0 1112 21.818z"/>
          </svg>
          Consultar ahora
        </a>
        <a href="/contacto" class="signals-btn signals-btn--outline">
          Solicitar diagnóstico
        </a>
      </div>
    </div>

  </div><!-- /container -->

  <!-- Bottom gold rule -->
  <div class="signals-bottom-rule" aria-hidden="true"></div>
</section>

<style>
  /* ─── SECTION ─────────────────────────────────────── */
  .signals-section {
    position: relative;
    padding: 100px 0 110px;
    background: linear-gradient(160deg, #0d1821 0%, #1a2b37 40%, #0f1e2a 100%);
    overflow: hidden;
  }

  .signals-top-rule,
  .signals-bottom-rule {
    position: absolute;
    left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent 0%, rgba(170,126,86,.5) 25%, #cca373 50%, rgba(170,126,86,.5) 75%, transparent 100%);
    z-index: 5;
    pointer-events: none;
  }
  .signals-top-rule    { top: 0; }
  .signals-bottom-rule { bottom: 0; }

  /* orbs */
  .signals-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    pointer-events: none;
  }
  .signals-orb-1 {
    width: 480px; height: 480px;
    top: -80px; right: -80px;
    background: radial-gradient(circle, rgba(170,126,86,.14) 0%, transparent 70%);
    animation: orb-float-a 18s ease-in-out infinite;
  }
  .signals-orb-2 {
    width: 380px; height: 380px;
    bottom: -60px; left: -60px;
    background: radial-gradient(circle, rgba(30,49,63,.20) 0%, transparent 70%);
    animation: orb-float-b 22s ease-in-out infinite;
  }
  @keyframes orb-float-a { 0%,100%{transform:translate(0,0)} 50%{transform:translate(-20px,25px)} }
  @keyframes orb-float-b { 0%,100%{transform:translate(0,0)} 50%{transform:translate(18px,-18px)} }

  /* ─── CONTAINER ─────────────────────────────────────── */
  .signals-container {
    max-width: 1220px;
    margin: 0 auto;
    padding: 0 32px;
    position: relative;
    z-index: 2;
  }
  @media (max-width: 600px) { .signals-container { padding: 0 18px; } }

  /* ─── HEADER ─────────────────────────────────────────── */
  .signals-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 72px;
  }

  .signals-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    background: rgba(204,163,115,.12);
    border: 1px solid rgba(204,163,115,.3);
    border-radius: 100px;
    margin-bottom: 28px;
    width: fit-content;
  }
  .signals-eyebrow-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #e25c5c;
    animation: blink-red 2s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes blink-red {
    0%,100% { opacity: 1; transform: scale(1); box-shadow: 0 0 0 0 rgba(226,92,92,.5); }
    50%      { opacity: .6; transform: scale(.75); box-shadow: 0 0 0 6px rgba(226,92,92,0); }
  }
  .signals-eyebrow-text {
    font-family: var(--font-heading);
    font-size: .73rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #cca373;
  }

  .signals-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 400;
    color: #fff;
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .signals-title em {
    font-style: italic;
    color: #cca373;
  }

  .signals-scratch {
    width: 64px; height: 4px;
    background: linear-gradient(90deg, #e25c5c, #cca373);
    border-radius: 2px;
    margin: 0 auto 22px;
  }

  .signals-subtitle {
    font-family: var(--font-body);
    font-size: clamp(.95rem, 1.6vw, 1.1rem);
    line-height: 1.72;
    color: rgba(255,255,255,.7);
    font-weight: 300;
  }
  .signals-subtitle strong { color: rgba(255,255,255,.92); font-weight: 600; }

  /* ─── GRID ───────────────────────────────────────────── */
  .signals-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
    margin-bottom: 60px;
  }
  @media (max-width: 1100px) {
    .signals-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 700px) {
    .signals-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
  }
  @media (max-width: 420px) {
    .signals-grid { grid-template-columns: 1fr; }
  }

  /* ─── SIGNAL CARD ────────────────────────────────────── */
  .signal-card {
    background: rgba(255,255,255,.05);
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 20px;
    padding: 28px 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
    overflow: hidden;
    transition: transform .4s cubic-bezier(.22,1,.36,1), border-color .35s ease, background .35s ease;
  }
  .signal-card:hover {
    transform: translateY(-6px);
    border-color: rgba(226,92,92,.35);
    background: rgba(255,255,255,.08);
  }
  /* top accent bar */
  .signal-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--card-accent, linear-gradient(90deg, #e25c5c, #cca373));
    transform: scaleX(0);
    transform-origin: left;
    border-radius: 20px 20px 0 0;
    transition: transform .45s cubic-bezier(.22,1,.36,1);
  }
  .signal-card:hover::before { transform: scaleX(1); }

  /* ─── Icons ─────────────────── */
  .signal-icon-wrap {
    width: 52px; height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
    flex-shrink: 0;
    transition: transform .4s cubic-bezier(.34,1.56,.64,1);
  }
  .signal-card:hover .signal-icon-wrap { transform: scale(1.1) rotate(-5deg); }
  .signal-icon-wrap svg { width: 24px; height: 24px; }

  .signal-icon--amber { background: rgba(245,158,11,.15); border: 1px solid rgba(245,158,11,.25); }
  .signal-icon--amber svg { stroke: #f59e0b; }

  .signal-icon--red   { background: rgba(226,92,92,.15); border: 1px solid rgba(226,92,92,.25); }
  .signal-icon--red svg { stroke: #e25c5c; }

  .signal-icon--orange { background: rgba(249,115,22,.15); border: 1px solid rgba(249,115,22,.25); }
  .signal-icon--orange svg { stroke: #f97316; }

  .signal-icon--blue  { background: rgba(96,165,250,.15); border: 1px solid rgba(96,165,250,.25); }
  .signal-icon--blue svg { stroke: #60a5fa; }

  /* ─── Card content ───────────────── */
  .signal-num {
    font-family: var(--font-display);
    font-size: .75rem;
    font-weight: 400;
    letter-spacing: .14em;
    color: rgba(255,255,255,.25);
    margin-bottom: 6px;
  }
  .signal-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 800;
    color: #fff;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1.25;
    margin-bottom: 10px;
  }
  .signal-desc {
    font-family: var(--font-body);
    font-size: .84rem;
    line-height: 1.65;
    color: rgba(255,255,255,.58);
    font-weight: 400;
    flex: 1;
    margin-bottom: 16px;
  }
  .signal-tag {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    background: rgba(226,92,92,.12);
    border: 1px solid rgba(226,92,92,.22);
    border-radius: 100px;
    font-family: var(--font-heading);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: #f87171;
    width: fit-content;
  }

  /* ─── BOTTOM CTA ─────────────────────────────────────── */
  .signals-cta {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 28px;
    background: rgba(226,92,92,.08);
    border: 1px solid rgba(226,92,92,.2);
    border-radius: 20px;
    padding: 32px 36px;
  }
  @media (max-width: 900px) {
    .signals-cta {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .signals-cta-icon { margin: 0 auto; }
    .signals-cta-actions { justify-content: center; }
  }

  .signals-cta-icon {
    width: 52px; height: 52px;
    border-radius: 50%;
    background: rgba(226,92,92,.15);
    border: 1px solid rgba(226,92,92,.3);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .signals-cta-icon svg { width: 26px; height: 26px; stroke: #f87171; }

  .signals-cta-text { flex: 1; }
  .signals-cta-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: #fff;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .signals-cta-sub {
    font-family: var(--font-body);
    font-size: .88rem;
    color: rgba(255,255,255,.58);
    line-height: 1.6;
    font-weight: 300;
  }

  .signals-cta-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-shrink: 0;
  }

  .signals-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 24px;
    border-radius: 12px;
    font-family: var(--font-accent);
    font-size: .9rem;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: transform .3s ease, box-shadow .3s ease;
  }
  .signals-btn:hover { transform: translateY(-2px); }

  .signals-btn--wa {
    background: linear-gradient(135deg, #25d366 0%, #128c7e 100%);
    color: #fff;
    box-shadow: 0 6px 20px rgba(37,211,102,.28);
  }
  .signals-btn--wa:hover { box-shadow: 0 10px 28px rgba(37,211,102,.40); }
  .signals-btn--wa svg { fill: #fff; }

  .signals-btn--outline {
    background: rgba(255,255,255,.07);
    border: 1px solid rgba(255,255,255,.18);
    color: rgba(255,255,255,.82);
    backdrop-filter: blur(4px);
  }
  .signals-btn--outline:hover { background: rgba(255,255,255,.12); }

  /* ─── REVEAL ANIMATIONS ──────────────────────────────── */
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity .6s ease, transform .6s cubic-bezier(.22,1,.36,1);
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }
  .reveal-d1 { transition-delay: .08s; }
  .reveal-d2 { transition-delay: .16s; }
  .reveal-d3 { transition-delay: .24s; }
  .reveal-d4 { transition-delay: .32s; }
  .reveal-d5 { transition-delay: .40s; }

  @media (max-width: 768px) {
    .signals-section { padding: 72px 0 80px; }
    .signals-header  { margin-bottom: 44px; }
    .signals-grid    { margin-bottom: 40px; }
    .signals-cta     { padding: 24px 20px; gap: 20px; }
  }
</style>

<script>
  const signalObserver = new IntersectionObserver(
    entries => entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('visible'); signalObserver.unobserve(e.target); }
    }),
    { threshold: 0.08 }
  );
  document.querySelectorAll('#senales .reveal').forEach(el => signalObserver.observe(el));
</script>
