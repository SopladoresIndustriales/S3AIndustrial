<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --gold:       #aa7e56;
    --gold-light: #d4a574;
    --gold-pale:  #cca373;
    --gold-dark:  #7b5433;
    --navy:       #1e313f;
    --navy-mid:   #2d4558;
    --navy-soft:  #334c60;
    --navy-muted: #5a7889;
    --cream:      #fdfcfb;
    --white:      #ffffff;
    --border-gold: rgba(170,126,86,.18);
    --border-navy: rgba(30,49,63,.15);
    --shadow-sm:  0 2px 12px rgba(0,0,0,.06);
    --shadow-md:  0 8px 32px rgba(0,0,0,.10);
    --shadow-lg:  0 20px 60px rgba(0,0,0,.12);
    --radius-card: 24px;
    --radius-btn:  16px;
    --ease-out: cubic-bezier(.22,1,.36,1);
  }

  html { font-size: 16px; scroll-behavior: smooth; }

  body {
    font-family: var(--font-body);
    background: var(--white);
    color: var(--navy);
    -webkit-font-smoothing: antialiased;
  }

  /* ─── SECTION ─────────────────────────────────────────── */
  #sectores {
    position: relative;
    padding: 48px 0 52px;
    overflow: hidden;
    background: linear-gradient(180deg,
      #fff 0%, #faf8f5 40%, #f8f6f2 70%, #fff 100%);
  }

  /* Ambient orbs */
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    will-change: transform;
  }
  .orb-1 {
    width: 560px; height: 560px;
    top: -80px; left: -120px;
    background: radial-gradient(circle, rgba(170,126,86,.13) 0%, transparent 70%);
    animation: drift1 14s ease-in-out infinite;
  }
  .orb-2 {
    width: 480px; height: 480px;
    bottom: 0; right: -100px;
    background: radial-gradient(circle, rgba(30,49,63,.10) 0%, transparent 70%);
    animation: drift2 18s ease-in-out infinite;
  }
  .orb-3 {
    width: 360px; height: 360px;
    top: 40%; left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(123,84,51,.08) 0%, transparent 70%);
    animation: drift1 22s ease-in-out infinite reverse;
  }
  @keyframes drift1 {
    0%,100% { transform: translate(0,0) scale(1); }
    50%      { transform: translate(30px,20px) scale(1.05); }
  }
  @keyframes drift2 {
    0%,100% { transform: translate(0,0); }
    50%      { transform: translate(-25px,15px); }
  }

  /* Subtle grain texture overlay */
  #sectores::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
    opacity: .4;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
    position: relative;
    z-index: 2;
  }

  /* ─── HEADER ──────────────────────────────────────────── */
  .section-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 28px;
  }

  .eyebrow-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 100px;
    background: rgba(170,126,86,.08);
    border: 1px solid rgba(170,126,86,.25);
    margin-bottom: 16px;
    backdrop-filter: blur(8px);
  }
  .eyebrow-badge .dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--gold);
    animation: pulse-dot 2s ease-in-out infinite;
  }
  @keyframes pulse-dot {
    0%,100% { opacity: 1; transform: scale(1); }
    50%      { opacity: .5; transform: scale(.75); }
  }
  .eyebrow-badge span {
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .section-headline {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.8vw, 2.2rem);
    font-weight: 400;
    line-height: 1.0;
    color: var(--navy);
    margin-bottom: 0;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .section-headline em {
    font-style: italic;
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 50%, var(--gold-dark) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* animated underline */
  .underline-anim {
    position: relative;
    display: inline-block;
    padding-right: 0.12em;
  }
  .underline-anim::after {
    content: '';
    position: absolute;
    left: 0; bottom: -6px;
    height: 3px;
    width: 100%;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--gold), var(--gold-light), var(--gold-dark));
    background-size: 200% 100%;
    animation: shimmer-line 3s linear infinite;
  }
  @keyframes shimmer-line {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .section-subtext {
    font-size: clamp(.95rem, 1.5vw, 1.15rem);
    line-height: 1.75;
    color: var(--navy-muted);
    font-weight: 400;
  }
  .section-subtext strong { color: var(--navy); font-weight: 700; }

  /* ─── THIN SEPARATOR LINE ─────────────────────────────── */
  .divider-line {
    width: 40px; height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--gold), var(--gold-light));
    margin: 0 auto 14px;
  }

  /* ─── CHIPS / PILLS ──────────────────────────────────── */
  .industries-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-bottom: 40px;
  }

  .industry-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px 8px 8px;
    background: var(--white);
    border: 1px solid rgba(170,126,86,.18);
    border-radius: 100px;
    box-shadow: 0 1px 6px rgba(0,0,0,.05);
    transition: transform .3s var(--ease-out), border-color .3s ease, box-shadow .3s ease;
    cursor: default;
  }
  .industry-chip:hover {
    transform: translateY(-2px);
    border-color: rgba(170,126,86,.38);
    box-shadow: 0 4px 14px rgba(0,0,0,.08);
  }

  .chip-icon {
    width: 28px; height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .chip-icon svg { width: 13px; height: 13px; stroke: #fff; }

  .chip-text { display: flex; flex-direction: column; gap: 1px; }

  .chip-name {
    font-family: var(--font-heading);
    font-size: .78rem;
    font-weight: 700;
    color: var(--navy);
    letter-spacing: .04em;
    text-transform: uppercase;
    line-height: 1.1;
  }
  .chip-sub {
    font-size: .65rem;
    color: var(--navy-muted);
    letter-spacing: .02em;
    line-height: 1.2;
  }

  /* chip color variants */
  .chip-gold .chip-icon  { background: linear-gradient(135deg, #aa7e56, #d4a574); }
  .chip-navy .chip-icon  { background: linear-gradient(135deg, #1e313f, #334c60); }
  .chip-rust .chip-icon  { background: linear-gradient(135deg, #7b5433, #aa7e56); }
  .chip-dark .chip-icon  { background: linear-gradient(135deg, #223546, #334c60); }
  .chip-warm .chip-icon  { background: linear-gradient(135deg, #cca373, #aa7e56); }
  .chip-teal .chip-icon  { background: linear-gradient(135deg, #2d6a6a, #3a8a74); }

  /* ─── CTA BLOCK ───────────────────────────────────────── */
  .cta-block {
    position: relative;
    border-radius: 32px;
    overflow: hidden;
    padding: 80px 64px;
  }
  @media (max-width: 900px) { .cta-block { padding: 56px 36px; } }
  @media (max-width: 600px) { .cta-block { padding: 48px 24px; border-radius: 24px; } }

  .cta-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(145deg, #1e313f 0%, #2d4558 50%, #1a2c3a 100%);
    z-index: 0;
  }
  /* Gold mesh top-left */
  .cta-bg::before {
    content: '';
    position: absolute;
    top: -80px; left: -80px;
    width: 420px; height: 420px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(170,126,86,.22) 0%, transparent 65%);
    filter: blur(40px);
  }
  /* Gold mesh bottom-right */
  .cta-bg::after {
    content: '';
    position: absolute;
    bottom: -60px; right: -60px;
    width: 380px; height: 380px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(212,165,116,.18) 0%, transparent 65%);
    filter: blur(40px);
  }

  /* thin top gold line */
  .cta-line {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg,
      transparent 0%, var(--gold) 30%, var(--gold-light) 50%, var(--gold) 70%, transparent 100%);
    z-index: 1;
  }

  .cta-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 56px;
  }
  @media (max-width: 900px) {
    .cta-inner { grid-template-columns: 1fr; gap: 40px; text-align: center; }
  }

  /* Stats row inside CTA */
  .cta-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 36px 0 0;
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 14px;
    overflow: hidden;
    background: rgba(255,255,255,.04);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px 12px;
    border-right: 1px solid rgba(255,255,255,.10);
  }
  .stat-item:last-child { border-right: none; }

  .stat-num {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 400;
    color: var(--gold-light);
    line-height: 1;
    margin-bottom: 6px;
    letter-spacing: 0.02em;
  }
  .stat-label {
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: rgba(255,255,255,.45);
    line-height: 1.3;
  }

  .cta-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: .76rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--gold-light);
    margin-bottom: 18px;
  }
  .cta-eyebrow::before {
    content: '';
    display: block;
    width: 28px; height: 1px;
    background: var(--gold-light);
  }
  @media (max-width: 900px) {
    .cta-eyebrow { justify-content: center; }
  }

  .cta-headline {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 3.2rem);
    font-weight: 400;
    color: var(--white);
    line-height: 1.15;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .cta-headline em {
    font-style: italic;
    color: var(--gold-light);
  }

  .cta-body {
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(255,255,255,.62);
    margin-top: 20px;
  }
  .cta-body strong { color: rgba(255,255,255,.88); font-weight: 600; }

  /* ── Right card ── */
  .cta-card {
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 20px;
    padding: 32px 36px;
    backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  @media (max-width: 600px) { .cta-card { padding: 24px 20px; } }

  .cta-card-title {
    font-family: var(--font-heading);
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--gold-light);
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(255,255,255,.08);
  }

  .cta-checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .cta-checklist li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: .95rem;
    font-weight: 500;
    color: rgba(255,255,255,.82);
    line-height: 1.4;
    text-align: left;
  }
  .cta-checklist li svg {
    width: 18px; height: 18px;
    stroke: var(--gold-light);
    flex-shrink: 0;
    background: rgba(170,126,86,.15);
    border-radius: 50%;
    padding: 2px;
  }

  /* Buttons column */
  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  @media (max-width: 900px) {
    .cta-actions { align-items: center; flex-direction: row; justify-content: center; flex-wrap: wrap; }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 30px;
    border-radius: var(--radius-btn);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: .95rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform .4s var(--ease-out), box-shadow .4s ease;
    white-space: nowrap;
    border: none;
    cursor: pointer;
  }
  .btn:hover { transform: translateY(-3px); }

  .btn-primary {
    background: linear-gradient(135deg, #aa7e56 0%, #7b5433 100%);
    color: #fff;
    box-shadow: 0 10px 32px rgba(170,126,86,.40);
    width: 100%;
    justify-content: center;
  }
  .btn-primary:hover { box-shadow: 0 16px 40px rgba(170,126,86,.50); }

  .btn-ghost {
    background: rgba(255,255,255,.07);
    border: 1px solid rgba(255,255,255,.18);
    color: rgba(255,255,255,.82);
    width: 100%;
    justify-content: center;
    backdrop-filter: blur(4px);
  }
  .btn-ghost:hover {
    background: rgba(255,255,255,.12);
    box-shadow: 0 8px 24px rgba(0,0,0,.15);
  }

  .btn svg { width: 16px; height: 16px; flex-shrink: 0; }
  .btn-arrow {
    width: 14px; height: 14px;
    margin-left: 4px;
    transition: transform .4s var(--ease-out);
  }
  .btn:hover .btn-arrow { transform: translateX(4px); }

  /* ─── ENTRY ANIMATIONS ────────────────────────────────── */
  .reveal {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity .7s ease, transform .7s var(--ease-out);
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .reveal-delay-1 { transition-delay: .10s; }
  .reveal-delay-2 { transition-delay: .18s; }
  .reveal-delay-3 { transition-delay: .26s; }
  .reveal-delay-4 { transition-delay: .34s; }
  .reveal-delay-5 { transition-delay: .42s; }
  .reveal-delay-6 { transition-delay: .50s; }
  .reveal-delay-7 { transition-delay: .58s; }
  .reveal-delay-8 { transition-delay: .66s; }

  /* ─── RESPONSIVE TWEAKS ───────────────────────────────── */
  @media (max-width: 1280px) {
    .container { padding: 0 24px; }
  }
  @media (max-width: 768px) {
    #sectores { padding: 40px 0 48px; }
    .section-header { margin-bottom: 20px; }
    .industries-chips { margin-bottom: 28px; gap: 8px; }
    .cta-block { padding: 36px 20px; }
    .stat-num { font-size: 1.8rem; }
  }
  @media (max-width: 480px) {
    .container { padding: 0 14px; }
    .cta-headline { font-size: 1.5rem; }
    #sectores { padding: 32px 0 40px; }
    .section-header { margin-bottom: 16px; }
    .eyebrow-badge { padding: 5px 12px; margin-bottom: 12px; }
    .eyebrow-badge span { font-size: .70rem; }
    .industry-chip { padding: 6px 12px 6px 6px; gap: 6px; }
    .chip-icon { width: 24px; height: 24px; }
    .chip-icon svg { width: 11px; height: 11px; }
    .chip-name { font-size: .72rem; }
    .chip-sub { font-size: .60rem; }
    .stat-num { font-size: 1.65rem; }
    .stat-label { font-size: .65rem; letter-spacing: .04em; }
    .stat-item { padding: 16px 8px; }
    .cta-stats { margin: 24px 0 0; border-radius: 12px; }
  }
</style>

<section id="sectores">

  <!-- Ambient orbs -->
  <div class="orb orb-1" aria-hidden="true"></div>
  <div class="orb orb-2" aria-hidden="true"></div>
  <div class="orb orb-3" aria-hidden="true"></div>

  <div class="container">

    <!-- ─── SECTION HEADER ─────────────────── -->
    <header class="section-header reveal">

      <div class="eyebrow-badge">
        <div class="dot"></div>
        <span>Sectores Industriales</span>
      </div>

      <div class="divider-line"></div>

      <h2 class="section-headline">
        Experiencia en<br>
        <em class="underline-anim">Múltiples Industrias</em>
      </h2>

    </header>

    <!-- ─── CHIPS ───────────────────────────── -->
    <div class="industries-chips reveal" style="transition-delay:.08s">

      <span class="industry-chip chip-gold">
        <span class="chip-icon" aria-hidden="true">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 2v5m2-5v5m2-5v5a2 2 0 01-2 2H9a2 2 0 01-2-2M9 9v13M15.5 2C14 3.5 14 6 14.5 8a1.5 1.5 0 001.5 1v13"/>
          </svg>
        </span>
        <span class="chip-text">
          <span class="chip-name">Alimentaria</span>
          <span class="chip-sub">Panadería · Lácteos</span>
        </span>
      </span>

      <span class="industry-chip chip-navy">
        <span class="chip-icon" aria-hidden="true">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
          </svg>
        </span>
        <span class="chip-text">
          <span class="chip-name">Química</span>
          <span class="chip-sub">Petroquímica · Farma</span>
        </span>
      </span>

      <span class="industry-chip chip-rust">
        <span class="chip-icon" aria-hidden="true">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243 4.243 3 3 0 004.243-4.243zm0-5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z"/>
          </svg>
        </span>
        <span class="chip-text">
          <span class="chip-name">Textil</span>
          <span class="chip-sub">Hilaterías · Teñido</span>
        </span>
      </span>

      <span class="industry-chip chip-dark">
        <span class="chip-icon" aria-hidden="true">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"/>
          </svg>
        </span>
        <span class="chip-text">
          <span class="chip-name">Minería</span>
          <span class="chip-sub">Extractiva · Minerales</span>
        </span>
      </span>

      <span class="industry-chip chip-warm">
        <span class="chip-icon" aria-hidden="true">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z"/>
          </svg>
        </span>
        <span class="chip-text">
          <span class="chip-name">Metalúrgica</span>
          <span class="chip-sub">Fundición · Siderurgia</span>
        </span>
      </span>

      <span class="industry-chip chip-teal">
        <span class="chip-icon" aria-hidden="true">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        </span>
        <span class="chip-text">
          <span class="chip-name">Papel</span>
          <span class="chip-sub">Celulosa · Cartón</span>
        </span>
      </span>

    </div><!-- /industries-chips -->

    <!-- ─── BOTTOM CTA BLOCK ───────────────── -->
    <div class="cta-block reveal" style="transition-delay:.2s">
      <div class="cta-bg"></div>
